<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <Target Name="RequireSources" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SoulsFormatsSource)' == ''" Text="Provide -p:SoulsFormatsSource=the local SoulsFormats library source directory" />
  </Target>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(SoulsFormatsSource)/**/*.cs" Exclude="$(SoulsFormatsSource)/obj/**/*.cs;$(SoulsFormatsSource)/bin/**/*.cs" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>
</Project>
